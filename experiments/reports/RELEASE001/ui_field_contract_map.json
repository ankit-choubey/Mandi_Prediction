      "fold_level_breakdown_naive_90.F4.coverage_pct": { "element_id": "bm-fold-grid / bm-regime-desc", "adapter": "Number(val).toFixed(2) + '%'", "expected": "72.26%" },
      "metric_denominators.interval_metrics_scope.total_issued_origins": { "element_id": "bm-fold-note", "adapter": "Number(val).toLocaleString()", "expected": "26,918" }
